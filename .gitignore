# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Datasets are never committed -- they are re-downloaded and cached per run.
data/
*.cif
*.json.gz
*.csv.gz
*.parquet
*.feather
*.h5
*.hdf5

# Raw per-run logs are build artifacts, not repository content.
results/raw/*
!results/raw/.gitkeep

# ...but the merged tables are. The *.csv.gz rule above is about datasets, and
# a per-step table is large enough to be worth compressing, so it needs an
# explicit exception or the collect job cannot add it.
!results/processed/*.csv.gz
!docs/*.csv.gz

# matminer / pymatgen caches
.matminer/
.pmgrc.yaml
